DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# Long recordings may take longer to transcribe (seconds).
ASR_TIMEOUT_SECONDS=300
TTS_MODEL=fnlp/MOSS-TTSD-v0.5
# Optional voice override; defaults to model name + :alex.
TTS_VOICE=
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/ai_interview_platform
ENVIRONMENT=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional absolute directory; defaults to backend/uploads.
# DATA_DIR=/absolute/path/to/mianmian-data
